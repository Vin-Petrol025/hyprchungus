{
   "action": {
      "default_icon": "beacon-icon-48.png"
   },
   "background": {
      "service_worker": "background.iife.js",
      "type": "module"
   },
   "content_scripts": [ {
      "all_frames": true,
      "js": [ "content/index.iife.js" ],
      "matches": [ "http://*/*", "https://*/*", "\u003Call_urls>" ]
   } ],
   "default_locale": "en",
   "description": "__MSG_extensionDescription__",
   "externally_connectable": {
      "matches": [ "*://*.facebook.com/*", "*://*.instagram.com/*", "*://*.commercepartnerhub.com/*" ]
   },
   "host_permissions": [ "\u003Call_urls>" ],
   "icons": {
      "128": "beacon-icon-128.png",
      "16": "beacon-icon-16.png",
      "24": "beacon-icon-24.png",
      "36": "beacon-icon-36.png",
      "48": "beacon-icon-48.png",
      "96": "beacon-icon-96.png"
   },
   "key": "",
   "manifest_version": 3,
   "minimum_chrome_version": "116",
   "name": "__MSG_extensionName__",
   "permissions": [ "storage", "scripting", "tabs", "activeTab", "unlimitedStorage", "webNavigation", "cookies", "webRequest", "alarms", "debugger", "tabGroups", "identity", "system.cpu", "system.memory", "sidePanel" ],
   "sandbox": {
      "pages": [ "report-frame.html" ]
   },
   "side_panel": {
      "default_path": "side-panel/index.html"
   },
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "4.0.14",
   "web_accessible_resources": [ {
      "matches": [ "*://*/*" ],
      "resources": [ "*.js", "*.css", "*.svg", "*.png", "*.gif", "*.webp" ]
   }, {
      "matches": [ "*://*/*" ],
      "resources": [ "report-viewer.html", "report-frame.html" ]
   } ]
}
